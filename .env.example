# SOCFortress WAF -> SIEM: environment variables (copy to .env, fill in)
# NEVER commit a real .env. This file uses placeholders only.

# --- WAF management API (JWT auth; a DEDICATED non-TOTP service account) ---
WAF_BASE=https://waf.example.local:8443
WAF_ADMIN_EMAIL=soc-collector@example.local
WAF_ADMIN_PASSWORD=CHANGE_ME

# --- Graylog (GELF/TCP input) ---
GRAYLOG_HOST=graylog.example.local

# --- Wazuh manager (SSH append to a json localfile) ---
WAZUH_SSH_HOST=wazuh.example.local
WAZUH_SSH_USER=svc-collector
WAZUH_SSH_KEY=/path/to/ssh_key

# --- Wazuh indexer (dashboard import + verification) ---
WAZUH_IDX_USER=admin
WAZUH_IDX_PASS=CHANGE_ME
